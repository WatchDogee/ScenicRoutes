root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space

[*.{kt,kts}]
# Disable wildcard import rule - too many violations in existing code
# Can be re-enabled later when codebase is cleaned up
ktlint_standard_no-wildcard-imports = disabled

